# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mavrovo

# JWT secret (change to a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Default admin (created by seed script)
DEFAULT_ADMIN_EMAIL=admin@mavrovo.gov.mk
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Администратор

# SMTP (optional — used by Пријави проблем form)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Општина Маврово и Ростуше <noreply@mavrovo.gov.mk>"
MAIL_TO=info@mavrovo.gov.mk
